# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Brass Foundation
SMTP_FROM_EMAIL=noreply@yourdomain.com

# App (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Razorpay — required for ₹10 membership registration + contributions
# Dashboard: https://dashboard.razorpay.com → Account & Settings → API Keys
# Use Test keys while developing (rzp_test_...), Live keys in production.
# Full guide: docs/RAZORPAY.md
# ---------------------------------------------------------------------------
# Public key used by Razorpay Checkout in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
# Secret key — server only, never expose to the client
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret (Dashboard → Webhooks → your endpoint secret)
# Webhook URL: https://YOUR_DOMAIN/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
